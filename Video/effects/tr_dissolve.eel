// LS Dissolve & Dip
//@ls category Transition
//@ls title Dissolve & Dip
//@ls where track
//@ls about Put on a track: every crossfade between items on that track becomes this transition, lasting as long as the crossfade. Cross dissolve, dip to black, white or a color, additive, blur and luma dissolves.
//@ls help srcmode Item crossfades: runs on every crossfade between items on this track. Manual: blends this track into the next track behind it using Manual progress.
//@ls help progress Manual mode: 0 shows this track, 1 the track behind. Keyframe 0 to 1 over the transition.
//@ls help reverse Swap outgoing and incoming (use if a direction comes out backwards).
//@ls help ease How the transition speeds up and slows down.
//@ls help style Kind of dissolve.
//@ls help dcr Dip color (used by Dip to color).
//@ls example Cross dissolve :: style=0
//@ls example Dip to black :: style=1
//@ls tip Put this on the track. Overlap two items on that track (a crossfade); the transition lasts as long as the overlap.
//@ls tip One instance handles every crossfade on the track. Use separate tracks for different transition styles.
//@ls enum style Cross dissolve|Dip to black|Dip to white|Dip to color|Additive dissolve|Blur dissolve|Luma dissolve
//@ls enum srcmode Item crossfades|Manual (this track to the one behind)
//@ls toggle reverse
//@ls enum ease Linear|Smooth|Ease in|Ease out
//@ls color "Dip color" dcr dcg dcb
//@param1:style 'Style' 0 0 6 0 1
//@param2:ease 'Smoothness' 1 0 3 1 1
//@param3:dcr 'Dip red' 0.2 0 1 0.2 0.001
//@param4:dcg 'Dip green' 0.6 0 1 0.6 0.001
//@param5:dcb 'Dip blue' 0.9 0 1 0.9 0.001
//@param6:srcmode 'Source' 0 0 1 0 1
//@param7:progress 'Manual progress' 0 0 1 0 0.001
//@param8:reverse 'Reverse' 0 0 1 0 1

colorspace = 'RGBA';
own = input_info(0, sw, sh);
// #include "lib/frame.eel"
ls_frame_size();
W = project_w; H = project_h;

// #include "lib/ease.eel"
// #include "lib/pyramid.eel"
// #include "lib/transition.eel"
// #include "lib/trstyles.eel"

tr_setup() ? tr_dissolve_draw(style, ls_ease(tr_p, ease == 0 ? 0 : ease), dcr, dcg, dcb)
: own ? gfx_blit(0, 1);
