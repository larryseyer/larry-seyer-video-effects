// Base picture for overlays (titles, callouts). On a transparent title carrier the overlay draws the tracks
// below; on a real video item it keeps that item's picture; on an empty track it draws what is underneath.
function ls_draw_base() local(bw, bh, base, carrier) (
  gfx_mode = 0; gfx_a = 1;
  carrier = ls_is_carrier();
  base = carrier ? input_track(0) : 0;
  base != 0 && input_info(base, bw, bh) ? gfx_blit(base, 1)
  : own && !carrier ? gfx_blit(0, 1)
  : ( gfx_set(0); gfx_fillrect(0, 0, W, H); );
);
