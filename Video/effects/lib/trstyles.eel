// Transition looks shared by the transition effects and the Multicam Switcher. Each draws canvas tr_a (outgoing)
// into canvas tr_b (incoming), both W x H, onto the frame at eased progress tp (0..1).
// #include "lib/pyramid.eel"

// Dissolve family. kind: 0 cross dissolve, 1 dip to black, 2 dip to white, 3 dip to color (dipr, dipg, dipb),
// 4 additive, 5 blur dissolve, 6 luma dissolve.
function tr_dissolve_draw(kind, tp, dipr, dipg, dipb) (
  gfx_mode = 0; gfx_a = 1;
  kind == 0 ? ( gfx_blit(tr_a); gfx_a = tp; gfx_blit(tr_b); )
  : kind >= 1 && kind <= 3 ? (
    tp < 0.5 ? gfx_blit(tr_a) : gfx_blit(tr_b);
    kind == 1 ? gfx_set(0, 0, 0, 1 - abs(tp - 0.5)*2) : kind == 2 ? gfx_set(1, 1, 1, 1 - abs(tp - 0.5)*2)
              : gfx_set(dipr, dipg, dipb, 1 - abs(tp - 0.5)*2);
    gfx_fillrect(0, 0, W, H);
  )
  : kind == 4 ? (
    gfx_set(0); gfx_fillrect(0, 0, W, H);
    gfx_mode = 1; gfx_a = min(2*(1 - tp), 1); gfx_blit(tr_a); gfx_a = min(2*tp, 1); gfx_blit(tr_b);
  )
  : kind == 5 ? (
    gfx_blit(tr_a); gfx_a = tp; gfx_blit(tr_b);
    tr_bamt = sin(tp*$pi);
    tr_bamt > 0.02 ? (
      trbl = gfx_img_resize(trbl, W, H);
      blur_copy(trbl, 1 + floor(tr_bamt*5));
      gfx_mode = 0; gfx_a = min(tr_bamt*1.5, 1); gfx_blit(trbl);
    );
  )
  : (
    gfx_blit(tr_a);
    tr_lp = tp*1.3 - 0.15;
    gfx_evalrect(0, 0, W, H, "
      _1 = min(max((tr_lp - (0.299*r + 0.587*g + 0.114*b)*(1/255))/0.15 + 0.5, 0), 1);
      r += (sr - r)*_1; g += (sg - g)*_1; b += (sb - b)*_1;
    ", 0, tr_b);
  );
  gfx_mode = 0; gfx_a = 1;
);

// Draws an image at an offset with a short motion-blur smear along the movement (strength tr_mblur, 0..1).
function tr_smear(img, ox, oy, vx, vy) local(k, n) (
  n = tr_mblur > 0.01 ? 6 : 1; k = 0;
  loop(n,
    gfx_a = 1/(k + 1);
    gfx_blit(img, 0, ox - vx*k/n, oy - vy*k/n, W, H);
    k += 1;
  );
  gfx_a = 1;
);

// Push family. kind: 0 push, 1 slide in, 2 slide out, 3 split open, 4 squeeze. way: 0 left, 1 right, 2 up, 3 down.
// raw is the uneased progress (drives the motion blur), mblur the motion blur amount.
function tr_push_draw(kind, way, tp, raw, mblur) local(vel, dx, dy, vx, vy, aw, ah) (
  tr_mblur = mblur;
  vel = sin(raw*$pi)*mblur*0.06;
  dx = way == 0 ? -1 : way == 1 ? 1 : 0; dy = way == 2 ? -1 : way == 3 ? 1 : 0;
  vx = dx*W*vel; vy = dy*H*vel;
  gfx_mode = 0x100; gfx_a = 1;
  gfx_set(0); gfx_fillrect(0, 0, W, H);
  kind == 0 ? (
    tr_smear(tr_a, dx*W*tp, dy*H*tp, vx, vy);
    tr_smear(tr_b, dx*W*(tp - 1), dy*H*(tp - 1), vx, vy);
  ) : kind == 1 ? (
    gfx_blit(tr_a);
    tr_smear(tr_b, dx*W*(tp - 1), dy*H*(tp - 1), vx, vy);
  ) : kind == 2 ? (
    gfx_blit(tr_b);
    tr_smear(tr_a, dx*W*tp, dy*H*tp, vx, vy);
  ) : kind == 3 ? (
    gfx_blit(tr_b);
    dy == 0 ? (
      gfx_blit(tr_a, 0, -W*0.5*tp, 0, W*0.5, H, 0, 0, W*0.5, H);
      gfx_blit(tr_a, 0, W*0.5 + W*0.5*tp, 0, W*0.5, H, W*0.5, 0, W*0.5, H);
    ) : (
      gfx_blit(tr_a, 0, 0, -H*0.5*tp, W, H*0.5, 0, 0, W, H*0.5);
      gfx_blit(tr_a, 0, 0, H*0.5 + H*0.5*tp, W, H*0.5, 0, H*0.5, W, H*0.5);
    );
  ) : (
    dy == 0 ? (
      aw = W*(1 - tp); dx < 0 ? ( gfx_blit(tr_a, 0, 0, 0, aw, H); gfx_blit(tr_b, 0, aw, 0, W - aw, H); )
                              : ( gfx_blit(tr_b, 0, 0, 0, W - aw, H); gfx_blit(tr_a, 0, W - aw, 0, aw, H); );
    ) : (
      ah = H*(1 - tp); dy < 0 ? ( gfx_blit(tr_a, 0, 0, 0, W, ah); gfx_blit(tr_b, 0, 0, ah, W, H - ah); )
                              : ( gfx_blit(tr_b, 0, 0, 0, W, H - ah); gfx_blit(tr_a, 0, 0, H - ah, W, ah); );
    );
  );
  gfx_mode = 0; gfx_a = 1;
);
