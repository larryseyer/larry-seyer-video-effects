// LS Zoom & Spin
//@ls category Transition
//@ls title Zoom & Spin
//@ls where track
//@ls about Put on a track: crossfades punch through with a zoom in, zoom out or spinning zoom, blurred at the peak for speed.
//@ls help srcmode Item crossfades: runs on every crossfade between items on this track. Manual: blends this track into the next track down using Manual progress.
//@ls help progress Manual mode: 0 shows this track, 1 the track below. Keyframe 0 to 1 over the transition.
//@ls help reverse Swap outgoing and incoming (use if a direction comes out backwards).
//@ls help style Zoom in through, zoom out, or spinning zoom.
//@ls help strength How far it zooms.
//@ls help blur Zoom blur at the peak.
//@ls example Punchy zoom-in :: style=0 strength=0.6
//@ls tip Put this on the track. Overlap two items on that track (a crossfade); the transition lasts as long as the overlap.
//@ls tip One instance handles every crossfade on the track. Use separate tracks for different transition styles.
//@ls enum style Zoom in|Zoom out|Spin
//@ls enum srcmode Item crossfades|Manual (this track to the one below)
//@ls toggle reverse
//@param1:style 'Style' 0 0 2 0 1
//@param2:strength 'Strength' 0.6 0 1 0.6 0.001
//@param3:blur 'Zoom blur' 0.6 0 1 0.6 0.001
//@param4:srcmode 'Source' 0 0 1 0 1
//@param5:progress 'Manual progress' 0 0 1 0 0.001
//@param6:reverse 'Reverse' 0 0 1 0 1

colorspace = 'RGBA';
own = input_info(0, sw, sh);
!project_wh_valid && own ? ( project_w = sw; project_h = sh; );
W = project_w; H = project_h;

// #include "lib/ease.eel"
// #include "lib/layer.eel"
// #include "lib/transition.eel"

// Draw image scaled by zs about the center and rotated by ang (radians), with radial blur samples.
function zdraw(img, zs, ang, alpha, bl) local(k, n, z2) (
  n = bl > 0.01 ? 6 : 1; k = 0;
  loop(n,
    z2 = zs*(1 + bl*0.25*k/n);
    dax = W*0.5; day = H*0.5; ax = W*0.5; ay = H*0.5; kx = ky = z2; ca = cos(ang); sa = sin(ang); cx0 = cy0 = 0;
    gfx_mode = 0x100;
    xblit(img, W, H, 0, 0, alpha/(k + 1));
    k += 1;
  );
);

tr_setup() ? (
  gfx_set(0); gfx_fillrect(0, 0, W, H);
  amt = 1 + strength*3;
  peak = sin(tr_p*$pi)*blur;
  tr_p < 0.5 ? (
    e = ls_ease(tr_p*2, 2);
    zs = style == 1 ? 1/(1 + (amt - 1)*e) : 1 + (amt - 1)*e;
    zdraw(tr_a, zs, style == 2 ? e*$pi*0.5*strength : 0, 1, peak);
  ) : (
    e = ls_ease((1 - tr_p)*2, 2);
    zs = style == 1 ? 1/(1 + (amt - 1)*e) : 1 + (amt - 1)*e;
    zdraw(tr_b, zs, style == 2 ? -e*$pi*0.5*strength : 0, 1, peak);
  );
  gfx_mode = 0; gfx_a = 1;
) : own ? gfx_blit(0, 1);
