// LS Glitch
//@ls category Look
//@ls title Glitch
//@ls where both
//@ls about Digital breakup: torn slices, displaced blocks and color splitting. Automate the amount for hits, or lock bursts to the beat.
//@ls help amount Overall strength; keyframe it for hits.
//@ls help slices Torn horizontal slices.
//@ls help blocks Displaced rectangles.
//@ls help rgb Color channel splitting.
//@ls help speed How often the glitch pattern changes per second.
//@ls help beatsync Bursts on every beat of the project tempo.
//@ls help seed Changes the random pattern.
//@ls example Glitch on the beat :: amount=0.7 beatsync=1 :: Set the project tempo to the song first.
//@ls toggle beatsync
//@param1:amount 'Amount' 0.5 0 1 0.5 0.001
//@param2:slices 'Slice tearing' 0.6 0 1 0.6 0.001
//@param3:blocks 'Block displacement' 0.5 0 1 0.5 0.001
//@param4:rgb 'Color split' 0.6 0 1 0.6 0.001
//@param5:speed 'Changes per second' 12 1 30 12 0.1
//@param6:beatsync 'Burst on each beat' 0 0 1 0 1
//@param7:seed 'Seed' 1 0 100 1 1

colorspace = 'RGBA';
own = input_info(0, sw, sh);
!project_wh_valid && own ? ( project_w = sw; project_h = sh; );
W = project_w; H = project_h;

// #include "lib/noise.eel"
// #include "lib/rgbsplit.eel"

own ? (
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(0, 1);
  step = floor(project_time*speed) + seed*101;
  beatsync > 0.5 ? ( ph = project_time_qn - floor(project_time_qn); lvl = amount*max(1 - ph*4, 0); )
                 : ( lvl = amount*(hash1(step*0.73) > 0.2 ? 1 : 0.25); );
  lvl > 0.01 ? (
    gl_c = gfx_img_resize(gl_c, W, H); gfx_dest = gl_c; gfx_blit(-1); gfx_dest = -1;
    n = floor(2 + slices*14*lvl); k = 0;
    loop(n,
      y0 = (hash1(step*1.1 + k*3.7)*0.5 + 0.5)*H; hgt = (0.01 + (hash1(step*2.3 + k)*0.5 + 0.5)*0.08)*H;
      off = hash1(step*4.1 + k*1.9)*W*0.12*lvl*slices;
      gfx_blit(gl_c, 0, off, y0, W, hgt, 0, y0, W, hgt);
      gfx_blit(gl_c, 0, off - W*sign(off), y0, W, hgt, 0, y0, W, hgt);
      k += 1;
    );
    n = floor(blocks*10*lvl); k = 0;
    loop(n,
      bw2 = (0.04 + (hash1(step*5.3 + k)*0.5 + 0.5)*0.2)*W; bh2 = (0.02 + (hash1(step*6.1 + k)*0.5 + 0.5)*0.1)*H;
      bx = (hash1(step*7.7 + k*2.1)*0.5 + 0.5)*(W - bw2); by = (hash1(step*8.9 + k*1.3)*0.5 + 0.5)*(H - bh2);
      sx = min(max(bx + hash1(step*9.7 + k)*W*0.15, 0), W - bw2); sy = min(max(by + hash1(step*3.1 + k)*H*0.1, 0), H - bh2);
      gfx_blit(gl_c, 0, bx, by, bw2, bh2, sx, sy, bw2, bh2);
      hash1(step*2.9 + k*5.1) > 0.6 ? ( gfx_set(hash1(k + step) > 0 ? 1 : 0, hash1(k*2 + step) > 0 ? 1 : 0, 1, 0.25, 1); gfx_fillrect(bx, by, bw2, bh2); gfx_mode = 0; );
      k += 1;
    );
    rgb_split(hash1(step*1.7)*rgb*lvl*W*0.025, hash1(step*2.7)*rgb*lvl*H*0.01);
  );
  gfx_mode = 0; gfx_a = 1;
);
