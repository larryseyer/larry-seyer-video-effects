// LS Flash, Glitch & Light Leak
//@ls category Transition
//@ls title Flash, Glitch & Light Leak
//@ls where track
//@ls about Put on a track: crossfades cut through a white flash, a digital glitch, a warm light leak or a film burn.
//@ls help srcmode Item crossfades: runs on every crossfade between items on this track. Manual: blends this track into the next track behind it using Manual progress.
//@ls help progress Manual mode: 0 shows this track, 1 the track behind. Keyframe 0 to 1 over the transition.
//@ls help reverse Swap outgoing and incoming (use if a direction comes out backwards).
//@ls help style Flash cuts through white; Glitch cuts with digital breakup; Light leak and Film burn add warm light.
//@ls help strength Strength of the flash or light.
//@ls help lcr Color of the light leak or film burn.
//@ls example White flash :: style=0
//@ls example Light leak :: style=2
//@ls tip Put this on the track. Overlap two items on that track (a crossfade); the transition lasts as long as the overlap.
//@ls tip One instance handles every crossfade on the track. Use separate tracks for different transition styles.
//@ls enum style Flash|Glitch|Light leak|Film burn
//@ls enum srcmode Item crossfades|Manual (this track to the one behind)
//@ls toggle reverse
//@ls color "Light color" lcr lcg lcb
//@param1:style 'Style' 0 0 3 0 1
//@param2:strength 'Strength' 0.8 0 1 0.8 0.001
//@param3:lcr 'Light red' 1 0 1 1 0.001
//@param4:lcg 'Light green' 0.62 0 1 0.62 0.001
//@param5:lcb 'Light blue' 0.25 0 1 0.25 0.001
//@param6:srcmode 'Source' 0 0 1 0 1
//@param7:progress 'Manual progress' 0 0 1 0 0.001
//@param8:reverse 'Reverse' 0 0 1 0 1

colorspace = 'RGBA';
own = input_info(0, sw, sh);
// #include "lib/frame.eel"
ls_frame_size();
W = project_w; H = project_h;

// #include "lib/ease.eel"
// #include "lib/noise.eel"
// #include "lib/rgbsplit.eel"

// #include "lib/transition.eel"

tr_setup() ? (
  gfx_mode = 0; gfx_a = 1;
  peak = 1 - abs(tr_p - 0.5)*2;
  style == 0 ? (
    zk = 1 + 0.06*peak*strength;
    gfx_set(0); gfx_fillrect(0, 0, W, H);
    gfx_mode = 0x100;
    gfx_blit(tr_p < 0.5 ? tr_a : tr_b, 0, (W - W*zk)*0.5, (H - H*zk)*0.5, W*zk, H*zk);
    gfx_mode = 0; gfx_set(1, 1, 1, min(peak^1.5*strength*1.2, 1)); gfx_fillrect(0, 0, W, H);
  ) : style == 1 ? (
    gfx_blit(tr_p < 0.5 ? tr_a : tr_b);
    lvl = peak*strength;
    step = floor(project_time*24);
    lvl > 0.02 ? (
      gl_c = gfx_img_resize(gl_c, W, H); gfx_dest = gl_c; gfx_blit(-1); gfx_dest = -1;
      k = 0;
      loop(floor(4 + 12*lvl),
        y0 = (hash1(step*1.1 + k*3.7)*0.5 + 0.5)*H; hgt = (0.01 + (hash1(step*2.3 + k)*0.5 + 0.5)*0.07)*H;
        off = hash1(step*4.1 + k*1.9)*W*0.15*lvl;
        gfx_blit(k & 1 ? tr_a : tr_b, 0, off, y0, W, hgt, 0, y0, W, hgt);
        k += 1;
      );
      rgb_split(hash1(step*1.7)*lvl*W*0.03, 0);
    );
  ) : (
    gfx_blit(tr_a); gfx_a = ls_ease(tr_p, 1); gfx_blit(tr_b); gfx_a = 1;
    style == 2 ? (
      sweep = -W*0.6 + tr_p*W*1.6;
      gfx_mode = 0x40001;
      gfx_gradrect(sweep - W*0.4, 0, W*0.4, H, lcr, lcg, lcb, 0, 0, 0, 0, peak*strength/(W*0.4), 0, 0, 0, 0);
      gfx_gradrect(sweep, 0, W*0.4, H, lcr, lcg, lcb, peak*strength, 0, 0, 0, -peak*strength/(W*0.4), 0, 0, 0, 0);
      gfx_set(lcr, lcg, lcb, peak*strength*0.25, 1); gfx_fillrect(0, 0, W, H);
    ) : (
      bcx = W*(0.3 + 0.4*hash1(floor(project_time))*0.5 + 0.2); bcy = H*0.55;
      rad = (0.2 + peak*1.1)*max(W, H)*0.5;
      fb_w = 64; fb_h = 36;
      fbm = gfx_img_resize(fbm, fb_w, fb_h);
      gfx_set(lcr, lcg, lcb, 1, 0, fbm, 1); gfx_fillrect(0, 0, fb_w, fb_h);
      gfx_dest = fbm; pk = peak*strength; mcx = bcx/W*fb_w; mcy = bcy/H*fb_h; mr = rad/W*fb_w;
      gfx_evalrect(0, 0, fb_w, fb_h, "
        _2 = (_1 % _span) + 0.5 - mcx; _3 = (_slice*_slice_size + floor(_1/_span) + 0.5 - mcy)*1.78;
        _4 = max(1 - sqrt(_2*_2 + _3*_3)/mr, 0);
        a = 255*min(_4*_4*pk*1.6, 1);
        _1 += 1;
      ");
      gfx_dest = -1; gfx_mode = 0x10101; gfx_a = 1;
      gfx_blit(fbm, 0, 0, 0, W, H, 0, 0, fb_w, fb_h);
    );
  );
  gfx_mode = 0; gfx_a = 1;
) : own ? gfx_blit(0, 1);
